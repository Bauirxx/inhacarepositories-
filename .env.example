# ============================================================
# INHACA CONNECT - Variaveis de ambiente
# Copie para .env.local (desenvolvimento) e configure na Vercel (producao).
# ============================================================

# URL publica da aplicacao (sem barra final). Usada em links de email, SEO e sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chave publica. Projetos novos usam "sb_publishable_..."; projetos antigos usam a "anon key" (JWT).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Compatibilidade: se o projeto ainda usa a anon key, defina-a aqui (a app aceita qualquer uma).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Chave privilegiada (NUNCA expor no frontend; usada apenas em codigo "server-only").
# Projetos novos: "sb_secret_..."; projetos antigos: service_role key.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Mapa ---
# Estilo vetorial MapLibre. Por omissao usa OpenFreeMap (gratuito, sem chave, dados OpenStreetMap).
# Alternativa: https://api.maptiler.com/maps/streets-v2/style.json?key=XXXX (requer conta MapTiler)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
